# UDP 500/4500 for US IPsec Wi-Fi Calling
AND,((GEOIP,US),(AND,((PROTOCOL,UDP),(OR,((DEST-PORT,500),(DEST-PORT,4500))))))

# Generic US MCC
DOMAIN-KEYWORD,mcc310
DOMAIN-KEYWORD,mcc311
DOMAIN-KEYWORD,mcc312
DOMAIN-KEYWORD,mcc313
DOMAIN-KEYWORD,mcc314
DOMAIN-KEYWORD,mcc315
DOMAIN-KEYWORD,mcc316

